    <script>
        const REWARDS_CATALOG = [
            {
                id: 'rw-1',
                title: 'خصم 20% في صيدليات العزبي والطرشوبي',
                cost: 100,
                category: 'خصومات صيدليات',
                icon: 'fa-prescription-bottle-medical',
                color: 'bg-emerald-500',
                desc: 'كوبون خصم ساري على كافة الأدوية والمستلزمات غير الخاضعة للتسعير الإجباري.'
            },
            {
                id: 'rw-2',
                title: 'خصم 50 ج.م على المستلزمات الطبية',
                cost: 150,
                category: 'مستلزمات',
                icon: 'fa-kit-medical',
                color: 'bg-teal-600',
                desc: 'قسيمة خصم مباشر عند شراء جهاز قياس الضغط، السكر، أو مستلزمات الإسعافات.'
            },
            {
                id: 'rw-3',
                title: 'خصم 30% على منتجات العناية بالبشرة',
                cost: 200,
                category: 'عناية بشرة',
                icon: 'fa-pump-soap',
                color: 'bg-purple-600',
                desc: 'قسيمة خصم ممتازة لمنتجات العناية بالشعر والبشرة والواقيات الشمسية.'
            },
            {
                id: 'rw-4',
                title: 'قسيمة فحص واستشارة طبية مجانية',
                cost: 250,
                category: 'استشارات',
                icon: 'fa-user-doctor',
                color: 'bg-blue-600',
                desc: 'كوبون كشف وتأمين طبي شامل في المراكز والعيادات الشريكة للمنصة.'
            }
        ];

        const medicineMap = new Map();
        const PACKAGING_TYPES = ['شريط حبوب', 'زجاجة شراب', 'أنبوبة مرهم', 'بخاخ طبي', 'حقنة معقمة'];
        const CATEGORIES = ['مسكنات ومضادات التهاب', 'مضادات حيوية', 'أدوية جهاز تنفسي', 'أدوية جهاز هضمي', 'أدوية قلب وضغط', 'فيتامينات ومكملات'];

        function generateDatabase() {
            const prefixes = ['Panadol', 'Augmentin', 'Brufen', 'Cataflam', 'Ketofan', 'Congestal', 'Omepak', 'Nexium', 'Amoxicillin', 'Ciprofar', 'Zithro', 'Concor', 'Glucophage', 'Eltroxin', 'Voltaren', 'Antinal', 'Flagyl', 'Motilium', 'Controloc', 'Aspirin', 'Lasix', 'Plavix', 'Lipitor', 'Ventolin', 'Symbicort'];
            const activeIngredients = ['Paracetamol', 'Amoxicillin / Clavulanate', 'Ibuprofen', 'Diclofenac Potassium', 'Ketoprofen', 'Paracetamol / Pseudoephedrine', 'Omeprazole', 'Esomeprazole', 'Ciprofloxacin', 'Azithromycin', 'Bisoprolol', 'Metformin', 'Levothyroxine', 'Nifuroxazide', 'Metronidazole', 'Domperidone', 'Atorvastatin', 'Salbutamol'];
            const forms = ['Tablet', 'Capsule', 'Syrup', 'Injection', 'Cream', 'Ointment', 'Drops', 'Spray', 'Suspension'];
            const strengths = ['10mg', '20mg', '50mg', '100mg', '200mg', '250mg', '500mg', '625mg', '1000mg'];
            const manufacturers = ['Eva Pharma', 'Amoun', 'EIPICO', 'Pharco', 'SEDICO', 'Pfizer Egypt', 'Novartis', 'GSK', 'Sanofi', 'Marcyrl'];

            let seed = 987654;
            function pseudoRandom() {
                let x = Math.sin(seed++) * 10000;
                return x - Math.floor(x);
            }

            for (let i = 0; i < 5000; i++) {
                let rawDigits = '622' + String(Math.floor(pseudoRandom() * 1000000000)).padStart(9, '0');
                
                let sumOdd = 0, sumEven = 0;
                for (let j = 0; j < 12; j++) {
                    let d = parseInt(rawDigits[j]);
                    if (j % 2 === 0) sumOdd += d;
                    else sumEven += d * 3;
                }
                let checkDigit = (10 - ((sumOdd + sumEven) % 10)) % 10;
                let fullBarcode = rawDigits + checkDigit;

                while (medicineMap.has(fullBarcode)) {
                    fullBarcode = (BigInt(fullBarcode) + 1n).toString();
                }

                let pName = prefixes[Math.floor(pseudoRandom() * prefixes.length)];
                let pForm = forms[Math.floor(pseudoRandom() * forms.length)];
                let pStrength = strengths[Math.floor(pseudoRandom() * strengths.length)];
                let pActive = activeIngredients[Math.floor(pseudoRandom() * activeIngredients.length)];
                let pCategory = CATEGORIES[Math.floor(pseudoRandom() * CATEGORIES.length)];
                let pPkg = PACKAGING_TYPES[Math.floor(pseudoRandom() * PACKAGING_TYPES.length)];
                let pMfr = manufacturers[Math.floor(pseudoRandom() * manufacturers.length)];

                medicineMap.set(fullBarcode, {
                    barcode: fullBarcode,
                    name: `${pName} ${pStrength} (${pForm})`,
                    activeIngredient: pActive,
                    category: pCategory,
                    packagingType: pPkg,
                    manufacturer: pMfr
                });
            }

            document.getElementById('dbCountStatus').innerHTML = `قاعدة البيانات جاهزة: <strong>5,000 دواء</strong>`;
            populateDatalist();
        }

        function populateDatalist() {
            const datalist = document.getElementById('medicineDatalist');
            let count = 0;
            let optionsHtml = '';
            for (let [barcode, data] of medicineMap.entries()) {
                if (count++ >= 250) break;
                optionsHtml += `<option value="${barcode}">${data.name} - ${data.packagingType}</option>`;
            }
            datalist.innerHTML = optionsHtml;
        }

        const STORAGE_KEY = 'medcycle_enterprise_final_v2026';
        let appState = {
            logs: [],
            redeemedVouchers: [],
            stats: {
                totalProcessed: 0,
                pointsEarned: 0,
                pointsSpent: 0,
                apiReclaimedGrams: 0,
                packagingRecycledGrams: 0
            }
        };

        function loadSavedState() {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    appState = Object.assign(appState, parsed);
                    if (!appState.stats.pointsSpent) appState.stats.pointsSpent = 0;
                } catch (e) {
                    console.error("State parse error:", e);
                }
            }
        }

        function saveAppState() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
            renderUI();
        }

        function getAvailablePoints() {
            return Math.max(0, appState.stats.pointsEarned - (appState.stats.pointsSpent || 0));
        }

        function resetSystemData() {
            Swal.fire({
                title: 'تأكيد تصفير البيانات',
                text: "أنت على وشك مسح كافة السجلات والإحصائيات والنقاط المخزنة بالمستعرض. هل تريد المتابعة؟",
                icon: 'warning',
                showCancelButton: true,
                showCloseButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#334155',
                confirmButtonText: 'نعم، قم بالمسح',
                cancelButtonText: 'إلغاء'
            }).then((result) => {
                if (result.isConfirmed) {
                    appState = {
                        logs: [],
                        redeemedVouchers: [],
                        stats: { totalProcessed: 0, pointsEarned: 0, pointsSpent: 0, apiReclaimedGrams: 0, packagingRecycledGrams: 0 }
                    };
                    saveAppState();
                    Swal.fire('تم المسح', 'تم تصفير لوحة البيانات والنقاط بنجاح.', 'success');
                }
            });
        }

        function renderRewardsGrid() {
            const container = document.getElementById('rewardsGrid');
            if (!container) return;

            const availPoints = getAvailablePoints();
            document.getElementById('storeSectionPoints').innerText = availPoints.toLocaleString('ar-EG');
            document.getElementById('headerPointsCounter').innerText = availPoints.toLocaleString('ar-EG');
            document.getElementById('statAvailablePoints').innerText = availPoints.toLocaleString('ar-EG');

            let html = '';
            REWARDS_CATALOG.forEach(item => {
                const canAfford = availPoints >= item.cost;
                html += `
                    <div class="flat-card p-4 flex flex-col justify-between reward-card border ${canAfford ? 'border-amber-200 bg-white' : 'border-slate-200 bg-slate-50/70'}">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded ${item.color} text-white">${item.category}</span>
                                <span class="font-black text-amber-600 text-xs flex items-center bg-amber-50 px-2 py-1 rounded border border-amber-200">
                                    <i class="fa-solid fa-coins ml-1"></i> ${item.cost} نقطة
                                </span>
                            </div>
                            <h4 class="font-bold text-slate-800 text-sm mb-1">${item.title}</h4>
                            <p class="text-[11px] text-slate-500 leading-relaxed mb-4">${item.desc}</p>
                        </div>

                        <button onclick="redeemRewardItem('${item.id}')" class="w-full font-bold py-2 px-3 rounded text-xs transition flex items-center justify-center ${canAfford ? 'bg-amber-500 hover:bg-amber-600 text-white shadow-sm' : 'bg-slate-200 text-slate-400 cursor-not-allowed'}">
                            <i class="fa-solid fa-ticket ml-1.5"></i> ${canAfford ? 'استبدال الآن' : 'نقاط غير كافية'}
                        </button>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        function redeemRewardItem(rewardId) {
            const item = REWARDS_CATALOG.find(r => r.id === rewardId);
            if (!item) return;

            const currentPoints = getAvailablePoints();
            if (currentPoints < item.cost) {
                return Swal.fire({
                    title: 'عفواً، رصيد النقاط غير كافٍ',
                    html: `تحتاج إلى <b>${item.cost - currentPoints}</b> نقطة إضافية لاستبدال هذه المكافأة.<br>قم بمسح وتدوير المزيد من الأدوية لكسب النقاط!`,
                    icon: 'warning',
                    confirmButtonColor: '#f59e0b',
                    showCloseButton: true
                });
            }

            const promoCode = 'MED-' + Math.floor(1000 + Math.random() * 9000) + '-SAVE';

            Swal.fire({
                title: 'تأكيد استبدال الكوبون',
                showCloseButton: true,
                html: `
                    <div class="text-right text-xs space-y-3 font-sans">
                        <p class="text-slate-600">هل ترغب في استبدال <b>${item.cost} نقطة</b> بالحصول على الكوبون التالي؟</p>
                        <div class="bg-amber-50 border border-amber-300 p-3 rounded text-center">
                            <h4 class="font-extrabold text-amber-900 text-sm mb-1">${item.title}</h4>
                            <span class="text-[11px] text-amber-700">${item.desc}</span>
                        </div>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'تأكيد الخصم والاستبدال',
                cancelButtonText: 'إلغاء',
                confirmButtonColor: '#f59e0b',
                cancelButtonColor: '#64748b'
            }).then((res) => {
                if (res.isConfirmed) {
                    appState.stats.pointsSpent += item.cost;
                    appState.redeemedVouchers.push({
                        id: promoCode,
                        title: item.title,
                        cost: item.cost,
                        date: new Date().toLocaleString('ar-EG')
                    });
                    saveAppState();

                    Swal.fire({
                        title: '🎉 مبروك! تم استبدال الكوبون بنجاح',
                        showCloseButton: true,
                        html: `
                            <div class="text-center space-y-3 font-sans">
                                <p class="text-xs text-slate-600">تم خصم ${item.cost} نقطة من رصيدك. كود الخصم الخاص بك هو:</p>
                                <div class="bg-slate-900 text-amber-400 font-mono text-lg font-black tracking-widest p-3 rounded border border-slate-700 select-all" id="promoCodeVal">
                                    ${promoCode}
                                </div>
                                <button onclick="copyCodeToClipboard('${promoCode}')" class="bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold py-2 px-4 rounded transition inline-flex items-center">
                                    <i class="fa-solid fa-copy ml-1.5"></i> نسخ كود الخصم
                                </button>
                                <p class="text-[10px] text-slate-400">يمكنك تقديم هذا الكود في أي صيدلية أو مركز طبي شريك للاستفادة بالخصم.</p>
                            </div>
                        `,
                        icon: 'success',
                        confirmButtonColor: '#0f766e',
                        confirmButtonText: 'تم'
                    });
                }
            });
        }

        function copyCodeToClipboard(codeText) {
            try {
                const dummy = document.createElement('textarea');
                document.body.appendChild(dummy);
                dummy.value = codeText;
                dummy.select();
                document.execCommand('copy');
                document.body.removeChild(dummy);

                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'تم نسخ كود الكوبون!',
                    showConfirmButton: false,
                    timer: 1500
                });
            } catch (e) {
                console.error("Copy failed", e);
            }
        }

